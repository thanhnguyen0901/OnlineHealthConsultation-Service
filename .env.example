# Environment template for OnlineHealthConsultation-Service

NODE_ENV=development
PORT=4000

# PostgreSQL connection string
DATABASE_URL=postgresql://healthuser:password@localhost:5432/health_consultation_db

# JWT secrets (replace in real environments)
JWT_SECRET=replace-with-strong-secret-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-another-strong-secret-at-least-32-chars
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# CORS (comma-separated origins)
# Required in production.
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Refresh token cookie
AUTH_REFRESH_COOKIE_NAME=ohc_refresh_token
AUTH_REFRESH_COOKIE_PATH=/api/auth
AUTH_REFRESH_COOKIE_SAME_SITE=lax
# Leave unset to use NODE_ENV=production as the secure-cookie switch.
# AUTH_REFRESH_COOKIE_SECURE=false

# Security/performance knobs
BCRYPT_ROUNDS=10
APP_TIMEZONE=Asia/Ho_Chi_Minh
APPOINTMENT_DURATION_MINUTES=60
APPOINTMENT_SLOT_STEP_MINUTES=30

# Password recovery
PASSWORD_RESET_TOKEN_TTL_MINUTES=15
PASSWORD_RESET_FRONTEND_URL=http://localhost:5173/reset-password
# Defaults to DEV_NOTIFICATION outside production and EMAIL_PROVIDER in production.
# PASSWORD_RESET_NOTIFICATION_PROVIDER=DEV_NOTIFICATION

# Notification delivery providers
# development: writes verifiable NotificationLog entries and app logs without external secrets.
# email: uses the email provider abstraction; set provider-specific secrets outside git.
# Production must use a non-development notification provider.
NOTIFICATION_PROVIDER=development
NOTIFICATION_EMAIL_PROVIDER=EMAIL_PROVIDER
NOTIFICATION_EMAIL_PROVIDER_ENABLED=false
# SMS is optional/future; leave disabled unless an SMS provider implementation is configured.
NOTIFICATION_SMS_PROVIDER=SMS_PROVIDER
NOTIFICATION_SMS_PROVIDER_ENABLED=false
